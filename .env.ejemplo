# Copia este fichero como .env, en esta misma carpeta, y pon tu clave. .env está en .gitignore y no
# se sube al repositorio. Las mismas variables valen como variables de entorno del sistema, que
# tienen prioridad; en GitHub Actions van como secreto y variable del repositorio.
DEEPSEEK_API_KEY=

# Opcionales
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Solo en Windows: Python no ve las raíces que el sistema aún no ha descargado, y sin esto fallan con
# CERTIFICATE_VERIFY_FAILED Noruega (data.stortinget.no) y Chile (opendata.camara.cl). El almacén de
# Mozilla que trae Git para Windows sirve. En Linux y en GitHub Actions no hace falta.
# SSL_CERT_FILE=C:/Program Files/Git/mingw64/etc/ssl/certs/ca-bundle.crt

# Minutos como mucho por recogida de Noruega (su API admite ~100 peticiones por minuto y recogerlo todo
# desde 2019 lleva unas 7 horas; cada recogida sigue donde se quedó la anterior).
# CONCORDIA_NOR_MINUTOS=40
